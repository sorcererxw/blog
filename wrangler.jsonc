{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "name": "blog",
  "compatibility_date": "2026-04-14",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_SITE_URL": "https://sorcererxw.com",
    "NOTION_BLOG_DATABASE_ID": "d6f20169e3b849059656e33a47e19003",
    "NOTION_PROJECTS_DATABASE_ID": "63605072597640c4b666cd334b428aee",
    "NOTION_INTRO_PAGE_ID": "ac63bdb57d224c41a951c0536396bdf4"
  },
  "secrets": {
    "required": [
      "NOTION_SECRET",
      "X_SECRET"
    ]
  },
  "triggers": {
    "crons": [
      "0 18 * * *"
    ]
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "sorcererxw.com"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "BLOG_CACHE",
      "id": "82255de05f7d4b9e8cf0cb43521ee243"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
