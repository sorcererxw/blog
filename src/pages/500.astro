---
import "@/styles/globals.css";
import styles from "@/styles/route-boundary.module.css";
---

<!doctype html>
<html lang="en" class="h-full antialiased font-sans">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>Unexpected error. | sorcererxw'blog</title>
    <meta content="noindex,nofollow,max-image-preview:large" name="robots" />
    <meta
      content="The page hit an unexpected error. Retry the page or return to the engineering archive."
      name="description"
    />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Outfit:wght@400;500;600&family=Roboto+Slab:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-full bg-background text-foreground">
    <section class={styles.boundary}>
      <div class="space-y-5">
        <p class="shell-eyebrow">Publication boundary</p>
        <h1 class="publication-home-title text-4xl">The page hit an unexpected error.</h1>
        <p class="publication-home-summary">
          Retry the page or return to the public reading surfaces. The failure was captured in the app boundary.
        </p>
        <div class="flex flex-wrap gap-3">
          <button class="publication-link" onclick="window.location.reload()" type="button">
            Try again
          </button>
          <a class="publication-link" href="/">Open homepage</a>
          <a class="publication-link" href="/blog">Open archive</a>
        </div>
      </div>
    </section>
  </body>
</html>
