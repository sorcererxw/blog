---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { ArticleList } from "@/domains/article/article-list";
import { listArticles } from "@/domains/article/list-articles";
import { buildSeo } from "@/domains/seo/build-seo";
import { buildCollectionPageStructuredData } from "@/domains/seo/build-structured-data";
import { articleListMemoryCache } from "@/integrations/kv/article-cache";
import { createBlogArticleSource } from "@/integrations/notion/articles";

export const prerender = true;

const items = await listArticles({
  source: createBlogArticleSource(),
  cache: articleListMemoryCache,
});
const description =
  "Technical writing on Astro, Cloudflare, Notion publishing, migrations, and the systems work behind building and shipping a public site.";
const seo = buildSeo({
  description,
  kind: "collection",
  pathname: Astro.url.pathname,
  structuredData: buildCollectionPageStructuredData({
    description,
    items: items.map((item) => ({
      name: item.title,
      url: `/articles/${item.slug}`,
    })),
    pathname: Astro.url.pathname,
    title: "Engineering writing archive",
  }),
  title: "Engineering writing archive for Astro, Cloudflare, and systems work",
});
---

<SiteLayout currentPath={Astro.url.pathname} seo={seo}>
  <ArticleList items={items} />
</SiteLayout>
