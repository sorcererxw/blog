---
import "../styles/globals.css";

import { SiteFooter } from "@/domains/shell/site-footer";
import { SiteHeader } from "@/domains/shell/site-header";
import { buildSeo } from "@/domains/seo/build-seo";
import { getRuntimeConfig } from "@/config/runtime";
import type { SeoDocument } from "@/domains/seo/model";

type Props = {
  seo?: SeoDocument;
  title?: string;
  description?: string;
  currentPath?: string;
};

const {
  seo,
  title,
  description = "sorcererxw blog",
  currentPath = Astro.url.pathname,
} = Astro.props;

const runtime = getRuntimeConfig();
const includeStack = !runtime.isProduction;
const documentSeo =
  seo ??
  buildSeo({
    description,
    kind: "collection",
    pathname: currentPath,
    title: title ?? "sorcererxw'blog",
  });
---

<!doctype html>
<html lang="en" class="h-full antialiased font-sans">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <title>{documentSeo.title}</title>
    <meta content={documentSeo.description} name="description" />
    <meta content={documentSeo.robots} name="robots" />
    <link href={documentSeo.canonicalUrl} rel="canonical" />
    <meta content={documentSeo.openGraph.title} property="og:title" />
    <meta content={documentSeo.openGraph.description} property="og:description" />
    <meta content={documentSeo.openGraph.type} property="og:type" />
    <meta content={documentSeo.openGraph.url} property="og:url" />
    <meta content={documentSeo.twitter.card} name="twitter:card" />
    <meta content={documentSeo.twitter.title} name="twitter:title" />
    <meta content={documentSeo.twitter.description} name="twitter:description" />
    {
      documentSeo.openGraph.image ? (
        <>
          <meta content={documentSeo.openGraph.image.url} property="og:image" />
          <meta content={documentSeo.openGraph.image.alt} property="og:image:alt" />
          {documentSeo.openGraph.image.width ? (
            <meta content={String(documentSeo.openGraph.image.width)} property="og:image:width" />
          ) : null}
          {documentSeo.openGraph.image.height ? (
            <meta content={String(documentSeo.openGraph.image.height)} property="og:image:height" />
          ) : null}
        </>
      ) : null
    }
    {
      documentSeo.twitter.image ? (
        <>
          <meta content={documentSeo.twitter.image.url} name="twitter:image" />
          <meta content={documentSeo.twitter.image.alt} name="twitter:image:alt" />
        </>
      ) : null
    }
    {
      documentSeo.openGraph.publishedTime ? (
        <meta content={documentSeo.openGraph.publishedTime} property="article:published_time" />
      ) : null
    }
    {
      documentSeo.openGraph.modifiedTime ? (
        <meta content={documentSeo.openGraph.modifiedTime} property="article:modified_time" />
      ) : null
    }
    {
      documentSeo.structuredData.map((item) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Outfit:wght@400;500;600&family=Roboto+Slab:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-full bg-background text-foreground">
    <div class="flex min-h-screen flex-col">
      <SiteHeader currentPath={currentPath} includeStack={includeStack} />
      <main class="flex-1 py-12">
        <slot />
      </main>
      <SiteFooter includeStack={includeStack} />
    </div>
  </body>
</html>
