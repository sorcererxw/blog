{
  "name": "blog2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "portless blog vite dev",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint",
    "deploy": "vite build && wrangler deploy",
    "upload": "vite build && wrangler versions upload",
    "cf-typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --config vitest.config.ts",
    "test:watch": "vitest --passWithNoTests --config vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/libre-bodoni": "^5.3.0",
    "@notionhq/client": "^5.15.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "@xdevplatform/xdk": "^0.5.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "portless": "^0.13.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
