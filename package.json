{
  "name": "blog2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=16",
    "pnpm": ">=6"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "portless blog next dev",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "seo:preview": "node ./scripts/seo-preview.mjs",
    "cf-typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --config vitest.config.ts",
    "test:watch": "vitest --passWithNoTests --config vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@chenglou/pretext": "^0.0.7",
    "@notionhq/client": "^5.15.0",
    "@opennextjs/cloudflare": "^1.19.9",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "portless": "^0.13.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "typescript-eslint": "^8.59.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.82.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.3",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
