{
  "name": "blog2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=16",
    "pnpm": ">=6"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "start": "astro preview --host 127.0.0.1",
    "lint": "eslint",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "upload": "astro build && wrangler deploy --dry-run",
    "sync:thoughts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./scripts/sync-thoughts.mjs",
    "seo:preview": "node ./scripts/seo-preview.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "astro check",
    "test": "vitest run --passWithNoTests --config vitest.config.ts",
    "test:watch": "vitest --passWithNoTests --config vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@mtcute/core": "^0.29.4",
    "@mtcute/node": "^0.29.4",
    "@notionhq/client": "^5.15.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "grammy": "^1.41.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.7.0",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.8.0",
    "recharts": "3.8.0",
    "shadcn": "^4.1.1",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^0.9.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/cloudflare": "13.1.9",
    "@astrojs/react": "5.0.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "astro": "6.1.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "vitest": "^2.1.8",
    "wrangler": "^4.82.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.3",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
